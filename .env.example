# Incident Agent local configuration template.
# Never put real secrets in this file.

INCIDENT_AGENT_HOST=127.0.0.1
INCIDENT_AGENT_PORT=8001
INCIDENT_AGENT_MODEL=deepseek-chat
INCIDENT_AGENT_BASE_URL=https://api.deepseek.com

# DevAtlas service
DEVATLAS_BASE_URL=http://127.0.0.1:8000
DEVATLAS_TIMEOUT_SECONDS=20

# Agent control
INCIDENT_MAX_ITERATIONS=4
INCIDENT_DEFAULT_TOP_K=5
# 单次模型调用的连接/读取超时（秒）。不要沿用 SDK 默认的 600 秒。
INCIDENT_MODEL_TIMEOUT_SECONDS=30
# 整个分析请求的时间预算（秒），应小于前端 axios 的 120 秒。
INCIDENT_REQUEST_TIMEOUT_SECONDS=90
INCIDENT_WEB_ORIGINS=http://127.0.0.1:5174

# Independent MySQL database
INCIDENT_DB_HOST=127.0.0.1
INCIDENT_DB_PORT=3306
INCIDENT_DB_NAME=incident_agent
INCIDENT_DB_USER=root
INCIDENT_DB_PASSWORD=replace-me

# Model and DevAtlas secrets are local-only.
DEEPSEEK_API_KEY=replace-me
